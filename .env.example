# Odoo XML-RPC connection
ODOO_URL=https://your-odoo-host.example.com
ODOO_DB=your_database
ODOO_USERNAME=your_username
ODOO_PASSWORD=your_password_or_api_key
ODOO_TIMEOUT=20
ODOO_REPORT_TIMEOUT=300

# Local Flask server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
MAX_UPLOAD_SIZE_MB=20
APP_TIMEZONE=Asia/Kolkata
PLANNER_SYNC_ENABLED=false
PLANNER_API_URL=http://127.0.0.1:8082/api
BARCODE_SYNC_TOKEN=replace-with-the-planner-shared-token
PLANNER_SYNC_TIMEOUT=15

# Postgres. DATABASE_URL is what the app reads; the POSTGRES_* values are only
# used by the db service in docker-compose.yml. URL-encode a password
# containing @ : / ? or #.
DATABASE_URL=postgresql://barcode:barcode@127.0.0.1:5432/barcode
DB_POOL_SIZE=5
POSTGRES_USER=barcode
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=barcode

# Production server
PORT=8000
BARCODE_PORT=8000
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=360
