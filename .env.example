# Odoo XML-RPC connection
ODOO_URL=https://your-odoo-host.example.com
ODOO_DB=your_database
ODOO_USERNAME=your_username
ODOO_PASSWORD=your_password_or_api_key
ODOO_TIMEOUT=20
ODOO_REPORT_TIMEOUT=300

# Local Flask server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
MAX_UPLOAD_SIZE_MB=20
APP_TIMEZONE=Asia/Kolkata
PLANNER_SYNC_ENABLED=false
PLANNER_API_URL=http://127.0.0.1:8082/api
BARCODE_SYNC_TOKEN=replace-with-the-planner-shared-token
PLANNER_SYNC_TIMEOUT=15

# Drawing/ECO revision check. Share the tracker sheet as Viewer with the service
# account's client_email, then set ECO_SHEET_ID. The full sheet URL is accepted;
# the id is the part between /d/ and /edit.
ECO_REVISION_CHECK_ENABLED=false
ECO_SHEET_ID=
ECO_SHEET_RANGE=Drawing!A:I
ECO_SHEET_CACHE_TTL=600
# A file path, the key JSON inline on one line in single quotes, or base64 of it.
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Postgres. This local URL uses your current OS/Postgres user. The POSTGRES_*
# values are only used by the db service in docker-compose.yml. URL-encode a
# password containing @ : / ? or # when using a password-based DATABASE_URL.
DATABASE_URL=postgresql:///barcode
DB_POOL_SIZE=5
POSTGRES_USER=barcode
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=barcode

# Production server
PORT=8000
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=360
